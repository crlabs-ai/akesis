# Akesis Environment Configuration Example
# Copy to .env and configure appropriately. NEVER commit .env to version control.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5436/akesis

# GitHub App / Webhook Credentials
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_TOKEN=your_github_token_here
GITHUB_API_URL=https://api.github.com

# Gemini AI Diagnostic & Fix Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30.0

# Codebase Context Configuration
REPO_CHECKOUT_BASE_DIR=/tmp/akesis/repos
MAX_CONTEXT_WINDOW_LINES=40
MAX_FILE_SIZE_BYTES=500000
MAX_EVIDENCE_FILES=3
MAX_TOTAL_SOURCE_CHARS=8000

# Fix Proposal Engine Configuration
MAX_FIX_TARGET_FILES=2
MAX_PATCH_LINES=100
MAX_PATCH_CHARS=4000
MIN_FIX_CONFIDENCE_THRESHOLD=0.60

# Docker Sandbox Validation Configuration
SANDBOX_IMAGE=akesis-validator:v1
SANDBOX_TIMEOUT_SECONDS=30.0
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MAX_OUTPUT_CHARS=4000
SANDBOX_BASE_DIR=/tmp/akesis/sandbox

# Slack / Human Approval Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_CHANNEL_ID=C0123456789
APPROVAL_TTL_HOURS=24
