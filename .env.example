# Akesis Environment Configuration Example
# Copy to .env and configure appropriately. NEVER commit .env to version control.

# ==============================================================================
# 1. Environment & Logging
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==============================================================================
# 2. API Security & Access Control
# ==============================================================================
# Read API Protection:
# In development: Leave blank to allow unauthenticated local development access.
# In production: Set a secure, dedicated token (distinct from GitHub/Slack/Gemini secrets).
# Required Header: X-Akesis-Read-Token: <token>
READ_API_TOKEN=

# CORS Configuration (Comma-separated or JSON list of allowed origins):
# In production: Explicit allowed origins only (NO wildcards).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,X-Akesis-Read-Token,X-Hub-Signature-256,X-GitHub-Event,X-Slack-Signature,X-Slack-Request-Timestamp,X-Request-ID,Authorization

# Trusted Hosts Protection (Comma-separated or JSON list):
# In production: Explicit domain names only (NO wildcards).
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,test

# ==============================================================================
# 3. Database Connection (PostgreSQL 16)
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5436/akesis

# ==============================================================================
# 4. GitHub App / Webhook Credentials
# ==============================================================================
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_TOKEN=your_github_token_here
GITHUB_API_URL=https://api.github.com

# ==============================================================================
# 5. Gemini AI Diagnostic & Fix Configuration
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60.0

# ==============================================================================
# 6. Codebase Context Configuration
# ==============================================================================
REPO_CHECKOUT_BASE_DIR=/tmp/akesis/repos
MAX_CONTEXT_WINDOW_LINES=40
MAX_FILE_SIZE_BYTES=500000
MAX_EVIDENCE_FILES=3
MAX_TOTAL_SOURCE_CHARS=8000

# ==============================================================================
# 7. Fix Proposal Engine Configuration
# ==============================================================================
MAX_FIX_TARGET_FILES=2
MAX_PATCH_LINES=100
MAX_PATCH_CHARS=4000
MIN_FIX_CONFIDENCE_THRESHOLD=0.60

# ==============================================================================
# 8. Docker Sandbox Validation Configuration
# ==============================================================================
SANDBOX_IMAGE=akesis-validator:v1
SANDBOX_TIMEOUT_SECONDS=30.0
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MAX_OUTPUT_CHARS=4000
SANDBOX_BASE_DIR=/tmp/akesis/sandbox

# ==============================================================================
# 9. Slack / Human Approval Configuration
# ==============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_CHANNEL_ID=C0123456789
APPROVAL_TTL_HOURS=24
