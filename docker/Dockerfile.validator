# Akesis Phase 5 Dedicated Validation Environment
# Contains pre-installed Python validation toolchain with non-root execution.
# Runtime network access is strictly disabled (--network none).

FROM python:3.12-slim

# Prevent interactive prompts and disable Python bytecode cache / buffering
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install git and required runtime tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Pre-install controlled V1 validation toolchains
RUN pip install --no-cache-dir \
    pytest==8.3.2 \
    ruff==0.6.2 \
    mypy==1.11.2

# Create unprivileged execution user
RUN groupadd -g 1000 akesis && \
    useradd -u 1000 -g akesis -s /bin/bash -m akesis

# Setup isolated workspace
WORKDIR /workspace
RUN chown -R akesis:akesis /workspace

USER akesis

# Default verification command
CMD ["python3", "-m", "compileall", "."]
